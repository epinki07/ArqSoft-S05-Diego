@model ArqSoft_S05_Diego.Models.Medico

@{
    ViewData["Title"] = "Detalle del Medico";
}

<section class="detail-panel">
    <div class="form-title">
        <h1>@Model.Nombre @Model.Apellido</h1>
        <p>Detalle del medico registrado.</p>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="detail-item">
                <span>Especialidad</span>
                <strong>@Model.Especialidad</strong>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-item">
                <span>Numero de licencia</span>
                <strong>@Model.NumeroLicencia</strong>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Medico" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</section>
