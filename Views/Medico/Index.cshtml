@model IEnumerable<ArqSoft_S05_Diego.Models.Medico>

@{
    ViewData["Title"] = "M�dicos";
}

<div class="container mt-5">
    <h1 class="mb-4">Listado de M�dicos</h1>

    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Especialidad</th>
                <th>N�mero de Licencia</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var medico in Model)
            {
                <tr>
                    <td>@medico.Id</td>
                    <td>@medico.Nombre</td>
                    <td>@medico.Apellido</td>
                    <td>@medico.Especialidad</td>
                    <td>@medico.NumeroLicencia</td>
                    <td>
                        <a href="@Url.Action("Detalle", "Medico", new { id = medico.Id })" class="btn btn-sm btn-info">Ver Detalle</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>