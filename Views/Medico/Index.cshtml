@model IEnumerable<ArqSoft_S05_Diego.Models.Medico>

@{
    ViewData["Title"] = "Medicos";
}

<section class="section-panel">
    <div class="section-header">
        <div>
            <h1>Medicos</h1>
            <p>Administra el directorio de especialistas y sus licencias.</p>
        </div>
        <a asp-controller="Medico" asp-action="Create" class="btn btn-success">Agregar medico</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Especialidad</th>
                    <th>Licencia</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Any() == true)
                {
                    @foreach (var medico in Model)
                    {
                        <tr>
                            <td>@medico.Id</td>
                            <td>
                                <strong>@medico.Nombre @medico.Apellido</strong>
                            </td>
                            <td>@medico.Especialidad</td>
                            <td>@medico.NumeroLicencia</td>
                            <td class="text-end">
                                <a asp-controller="Medico" asp-action="Detalle" asp-route-id="@medico.Id" class="btn btn-sm btn-outline-primary">Detalle</a>
                                <a asp-controller="Medico" asp-action="Edit" asp-route-id="@medico.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                                <form method="post" asp-controller="Medico" asp-action="Delete" class="d-inline">
                                    <input type="hidden" name="id" value="@medico.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Esta seguro?')">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="empty-row">No hay medicos registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
