@model ArqSoft_S05_Diego.Models.Paciente

@{
    ViewData["Title"] = "Editar Paciente";
}

<section class="form-panel">
    <div class="form-title">
        <h1>Editar paciente</h1>
        <p>Actualiza la informacion de contacto del paciente.</p>
    </div>

    <form method="post" class="row g-3">
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="col-md-6">
            <label for="nombre" class="form-label">Nombre</label>
            <input type="text" class="form-control" id="nombre" name="nombre" value="@Model.Nombre" placeholder="Nombre del paciente" required>
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label for="apellido" class="form-label">Apellido</label>
            <input type="text" class="form-control" id="apellido" name="apellido" value="@Model.Apellido" placeholder="Apellido del paciente" required>
            <span asp-validation-for="Apellido" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" name="email" value="@Model.Email" placeholder="correo@ejemplo.com" required>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label for="telefono" class="form-label">Telefono</label>
            <input type="tel" class="form-control" id="telefono" name="telefono" value="@Model.Telefono" placeholder="555-0000" required>
            <span asp-validation-for="Telefono" class="text-danger"></span>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-controller="Paciente" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</section>
