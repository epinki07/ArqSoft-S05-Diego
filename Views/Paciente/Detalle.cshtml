@model ArqSoft_S05_Diego.Models.Paciente

@{
    ViewData["Title"] = "Detalle del Paciente";
}

<section class="detail-panel">
    <div class="form-title">
        <h1>@Model.Nombre @Model.Apellido</h1>
        <p>Detalle del paciente registrado.</p>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="detail-item">
                <span>Email</span>
                <strong>@Model.Email</strong>
            </div>
        </div>
        <div class="col-md-6">
            <div class="detail-item">
                <span>Telefono</span>
                <strong>@Model.Telefono</strong>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <a asp-controller="Cita" asp-action="PorPaciente" asp-route-pacienteId="@Model.Id" class="btn btn-primary">Ver citas</a>
        <a asp-controller="Paciente" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</section>
