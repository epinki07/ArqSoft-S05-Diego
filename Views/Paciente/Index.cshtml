@model IEnumerable<ArqSoft_S05_Diego.Models.Paciente>

@{
    ViewData["Title"] = "Pacientes";
}

<section class="section-panel">
    <div class="section-header">
        <div>
            <h1>Pacientes</h1>
            <p>Consulta, registra y actualiza los datos de los pacientes.</p>
        </div>
        <a asp-controller="Paciente" asp-action="Create" class="btn btn-success">Agregar paciente</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Telefono</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Any() == true)
                {
                    @foreach (var paciente in Model)
                    {
                        <tr>
                            <td>@paciente.Id</td>
                            <td>
                                <strong>@paciente.Nombre @paciente.Apellido</strong>
                            </td>
                            <td>@paciente.Email</td>
                            <td>@paciente.Telefono</td>
                            <td class="text-end">
                                <a asp-controller="Paciente" asp-action="Detalle" asp-route-id="@paciente.Id" class="btn btn-sm btn-outline-primary">Detalle</a>
                                <a asp-controller="Paciente" asp-action="Edit" asp-route-id="@paciente.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                                <form method="post" asp-controller="Paciente" asp-action="Delete" class="d-inline">
                                    <input type="hidden" name="id" value="@paciente.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Esta seguro?')">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="empty-row">No hay pacientes registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
