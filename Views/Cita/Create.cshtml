@model CitasApp.Models.Cita

@{
    ViewData["Title"] = "Nueva Cita";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h3 class="mb-0 text-white">
                        <i class="fas fa-calendar-plus"></i> Agendar Nueva Cita
                    </h3>
                </div>
                <div class="card-body p-5">
                    <form method="post" novalidate>
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label for="pacienteId" class="form-label">
                                    <i class="fas fa-user-injured"></i> Paciente
                                </label>
                                <select class="form-select" id="pacienteId" name="pacienteId" required>
                                    <option value="">-- Seleccionar paciente --</option>
                                    @foreach (var paciente in (IEnumerable<CitasApp.Models.Paciente>)ViewBag.Pacientes)
                                    {
                                        <option value="@paciente.Id">@paciente.Nombre @paciente.Apellido</option>
                                    }
                                </select>
                                <span asp-validation-for="PacienteId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label for="medicoId" class="form-label">
                                    <i class="fas fa-stethoscope"></i> Médico
                                </label>
                                <select class="form-select" id="medicoId" name="medicoId" required>
                                    <option value="">-- Seleccionar médico --</option>
                                    @foreach (var medico in (IEnumerable<CitasApp.Models.Medico>)ViewBag.Medicos)
                                    {
                                        <option value="@medico.Id">@medico.Nombre @medico.Apellido (@medico.Especialidad)</option>
                                    }
                                </select>
                                <span asp-validation-for="MedicoId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label for="fecha" class="form-label">
                                    <i class="fas fa-calendar"></i> Fecha
                                </label>
                                <input type="date" class="form-control" id="fecha" name="fecha" required>
                                <span asp-validation-for="Fecha" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label for="hora" class="form-label">
                                    <i class="fas fa-clock"></i> Hora
                                </label>
                                <input type="time" class="form-control" id="hora" name="hora" required>
                                <span asp-validation-for="Hora" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="motivo" class="form-label">
                                <i class="fas fa-notes-medical"></i> Motivo de la Consulta
                            </label>
                            <input type="text" class="form-control" id="motivo" name="motivo" placeholder="Describe el motivo de la cita" required>
                            <span asp-validation-for="Motivo" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label for="estado" class="form-label">
                                <i class="fas fa-check-circle"></i> Estado Inicial
                            </label>
                            <select class="form-select" id="estado" name="estado">
                                <option value="Pendiente">Pendiente</option>
                                <option value="Confirmada">Confirmada</option>
                                <option value="Cancelada">Cancelada</option>
                            </select>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                                <i class="fas fa-save"></i> Guardar Cita
                            </button>
                            <a href="@Url.Action("Index", "Cita")" class="btn btn-secondary btn-lg">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
