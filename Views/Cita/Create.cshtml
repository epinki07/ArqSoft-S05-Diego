@model ArqSoft_S05_Diego.Models.Cita

@{
    ViewData["Title"] = "Agregar Cita";
}

<section class="form-panel">
    <div class="form-title">
        <h1>Agregar cita</h1>
        <p>Programa una nueva consulta entre paciente y medico.</p>
    </div>

    <form method="post" class="row g-3">
        <div class="col-md-6">
            <label for="pacienteId" class="form-label">Paciente</label>
            <select class="form-select" id="pacienteId" name="pacienteId" required>
                <option value="">Seleccionar paciente...</option>
                @foreach (var paciente in (IEnumerable<ArqSoft_S05_Diego.Models.Paciente>)ViewBag.Pacientes)
                {
                    <option value="@paciente.Id">@paciente.Nombre @paciente.Apellido</option>
                }
            </select>
            <span asp-validation-for="PacienteId" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label for="medicoId" class="form-label">Medico</label>
            <select class="form-select" id="medicoId" name="medicoId" required>
                <option value="">Seleccionar medico...</option>
                @foreach (var medico in (IEnumerable<ArqSoft_S05_Diego.Models.Medico>)ViewBag.Medicos)
                {
                    <option value="@medico.Id">@medico.Nombre @medico.Apellido (@medico.Especialidad)</option>
                }
            </select>
            <span asp-validation-for="MedicoId" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label for="fecha" class="form-label">Fecha</label>
            <input type="date" class="form-control" id="fecha" name="fecha" required>
            <span asp-validation-for="Fecha" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label for="hora" class="form-label">Hora</label>
            <input type="time" class="form-control" id="hora" name="hora" required>
            <span asp-validation-for="Hora" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label for="motivo" class="form-label">Motivo</label>
            <input type="text" class="form-control" id="motivo" name="motivo" placeholder="Motivo de la consulta" required>
            <span asp-validation-for="Motivo" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label for="estado" class="form-label">Estado</label>
            <select class="form-select" id="estado" name="estado">
                <option value="Pendiente">Pendiente</option>
                <option value="Confirmada">Confirmada</option>
                <option value="Cancelada">Cancelada</option>
            </select>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar cita</button>
            <a asp-controller="Cita" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</section>
