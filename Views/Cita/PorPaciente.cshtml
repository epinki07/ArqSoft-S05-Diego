@model IEnumerable<ArqSoft_S05_Diego.Models.Cita>

@{
    ViewData["Title"] = "Citas por Paciente";
}

<section class="section-panel">
    <div class="section-header">
        <div>
            <h1>Citas por paciente</h1>
            <p>Historial de citas asociadas al paciente seleccionado.</p>
        </div>
        <a asp-controller="Cita" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Medico</th>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Motivo</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Any() == true)
                {
                    @foreach (var cita in Model)
                    {
                        var medico = ((IEnumerable<ArqSoft_S05_Diego.Models.Medico>)ViewBag.Medicos)?.FirstOrDefault(m => m.Id == cita.MedicoId);

                        <tr>
                            <td>@cita.Id</td>
                            <td>@medico?.Nombre @medico?.Apellido</td>
                            <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@cita.Hora</td>
                            <td>@cita.Motivo</td>
                            <td>
                                <span class="badge @(cita.Estado == "Confirmada" ? "bg-success" : cita.Estado == "Cancelada" ? "bg-danger" : "bg-warning text-dark")">
                                    @cita.Estado
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="empty-row">No hay citas para este paciente.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
