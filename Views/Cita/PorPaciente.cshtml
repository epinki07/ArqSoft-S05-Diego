@model IEnumerable<CitasApp.Models.Cita>

@{
    ViewData["Title"] = "Citas por Paciente";
}

<div class="container mt-5">
    <h1 class="mb-4">Citas por Paciente</h1>

    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Médico</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Motivo</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.Any() == true)
            {
                @foreach (var cita in Model)
                {
                    var medico = ((IEnumerable<CitasApp.Models.Medico>)ViewBag.Medicos)?.FirstOrDefault(m => m.Id == cita.MedicoId);

                    <tr>
                        <td>@cita.Id</td>
                        <td>@medico?.Nombre @medico?.Apellido</td>
                        <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@cita.Hora</td>
                        <td>@cita.Motivo</td>
                        <td>
                            <span class="badge @(cita.Estado == "Confirmada" ? "bg-success" : cita.Estado == "Cancelada" ? "bg-danger" : "bg-warning")">
                                @cita.Estado
                            </span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">No hay citas para este paciente</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-4">
        <a href="@Url.Action("Index", "Cita")" class="btn btn-secondary">Volver al Listado</a>
    </div>
</div>
