@model IEnumerable<ArqSoft_S05_Diego.Models.Cita>

@{
    ViewData["Title"] = "Citas";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Listado de Citas</h1>
        <a href="@Url.Action("Create", "Cita")" class="btn btn-success">+ Agregar Cita</a>
    </div>

    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Paciente</th>
                <th>Medico</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Motivo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cita in Model)
            {
                var paciente = ((IEnumerable<ArqSoft_S05_Diego.Models.Paciente>)ViewBag.Pacientes)?.FirstOrDefault(p => p.Id == cita.PacienteId);
                var medico = ((IEnumerable<ArqSoft_S05_Diego.Models.Medico>)ViewBag.Medicos)?.FirstOrDefault(m => m.Id == cita.MedicoId);

                <tr>
                    <td>@cita.Id</td>
                    <td>@paciente?.Nombre @paciente?.Apellido</td>
                    <td>@medico?.Nombre @medico?.Apellido</td>
                    <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@cita.Hora</td>
                    <td>@cita.Motivo</td>
                    <td>
                        <span class="badge @(cita.Estado == "Confirmada" ? "bg-success" : cita.Estado == "Cancelada" ? "bg-danger" : "bg-warning")">
                            @cita.Estado
                        </span>
                    </td>
                    <td>
                        <a href="@Url.Action("Edit", "Cita", new { id = cita.Id })" class="btn btn-sm btn-warning">Editar</a>
                        <form method="post" action="@Url.Action("Delete", "Cita")" style="display:inline;">
                            <input type="hidden" name="id" value="@cita.Id" />
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Esta seguro?')">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
