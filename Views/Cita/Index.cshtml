@model IEnumerable<ArqSoft_S05_Diego.Models.Cita>

@{
    ViewData["Title"] = "Citas";
}

<section class="section-panel">
    <div class="section-header">
        <div>
            <h1>Citas</h1>
            <p>Revisa la agenda medica y el estado de cada consulta.</p>
        </div>
        <a asp-controller="Cita" asp-action="Create" class="btn btn-success">Agregar cita</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Paciente</th>
                    <th>Medico</th>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Motivo</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Any() == true)
                {
                    @foreach (var cita in Model)
                    {
                        var paciente = ((IEnumerable<ArqSoft_S05_Diego.Models.Paciente>)ViewBag.Pacientes)?.FirstOrDefault(p => p.Id == cita.PacienteId);
                        var medico = ((IEnumerable<ArqSoft_S05_Diego.Models.Medico>)ViewBag.Medicos)?.FirstOrDefault(m => m.Id == cita.MedicoId);

                        <tr>
                            <td>@cita.Id</td>
                            <td>@paciente?.Nombre @paciente?.Apellido</td>
                            <td>@medico?.Nombre @medico?.Apellido</td>
                            <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@cita.Hora</td>
                            <td>@cita.Motivo</td>
                            <td>
                                <span class="badge @(cita.Estado == "Confirmada" ? "bg-success" : cita.Estado == "Cancelada" ? "bg-danger" : "bg-warning text-dark")">
                                    @cita.Estado
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-controller="Cita" asp-action="Edit" asp-route-id="@cita.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                                <form method="post" asp-controller="Cita" asp-action="Delete" class="d-inline">
                                    <input type="hidden" name="id" value="@cita.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Esta seguro?')">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="empty-row">No hay citas registradas.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
